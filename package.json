{
  "name": "amrutam-telemedicine",
  "version": "1.0.0",
  "description": "Amrutam Telemedicine Platform \u2014 production-grade backend (NestJS, PostgreSQL, Redis, BullMQ, OpenTelemetry)",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "db:migrate": "ts-node scripts/migrate.ts",
    "db:reset": "ts-node scripts/migrate.ts --reset",
    "demo": "ts-node -r tsconfig-paths/register scripts/demo-flow.ts",
    "dev:stack": "ts-node scripts/dev-stack.ts",
    "format": "prettier --write \"{src,test,scripts,load}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test,scripts,load}/**/*.ts\"",
    "keys:generate": "ts-node scripts/generate-keys.ts",
    "keys:rotate": "ts-node scripts/rotate-keys.ts",
    "lint": "eslint \"{src,test,scripts,load}/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"{src,test,scripts,load}/**/*.ts\" --fix",
    "load:run": "ts-node -r tsconfig-paths/register load/run-load.ts",
    "openapi:generate": "ts-node scripts/generate-openapi.ts",
    "prebuild": "rimraf dist",
    "seed": "ts-node scripts/seed.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "test": "jest --config jest.config.js --selectProjects unit",
    "test:all": "jest --config jest.config.js --runInBand",
    "test:cov": "jest --config jest.config.js --runInBand --coverage",
    "test:integration": "jest --config jest.config.js --selectProjects integration --runInBand",
    "test:unit": "jest --config jest.config.js --selectProjects unit",
    "typecheck": "tsc --noEmit",
    "worker": "ts-node -r tsconfig-paths/register src/worker.ts",
    "worker:prod": "node dist/src/worker.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.54.2",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-node": "^0.54.2",
    "@opentelemetry/sdk-trace-node": "^1.28.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "bullmq": "^5.34.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-orm": "^0.38.3",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "luxon": "^3.5.0",
    "nestjs-pino": "^4.1.0",
    "otplib": "^12.0.1",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/autocannon": "^7.12.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.17.10",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "autocannon": "^8.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
